{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/integrallis/models/blob/main/docs/native-shims/registry.schema.json",
  "title": "Native shim inventory and evidence registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "capabilities",
    "exports",
    "migrationChecklist",
    "operations",
    "sourceScopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "exports": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cuda": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "migrationChecklist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "sourceScopes": {
      "type": "object",
      "required": [
        "cpu",
        "cuda"
      ],
      "properties": {
        "cpu": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "cuda": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "historical",
            "current"
          ]
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "status",
        "summary",
        "capabilities",
        "exports",
        "dispatch",
        "requiredProfiles",
        "evidence",
        "remaining",
        "sourceScope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "UNPROVEN",
            "INACTIVE_EXPERIMENT",
            "PROVEN_REQUIRED",
            "JAVA_REPLACEMENT_READY",
            "RETIRED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exports": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "cuda": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "dispatch": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "anchor"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "requiredProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sourceScope": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "proof": {
          "$ref": "#/$defs/reference"
        },
        "replacementEvidence": {
          "$ref": "#/$defs/reference"
        }
      },
      "additionalProperties": false
    }
  }
}
